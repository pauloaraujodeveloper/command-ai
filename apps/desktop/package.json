{
  "name": "@command-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Command AI para desktop: a mesma interface do painel web, em uma janela própria.",
  "author": "Command AI",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "typecheck": "node --check main.cjs && node --check config.cjs",
    "build": "node --check main.cjs && node --check config.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win zip",
    "dist:win:installer": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "dev.commandai.desktop",
    "productName": "Command AI",
    "copyright": "Command AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "config.cjs",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}

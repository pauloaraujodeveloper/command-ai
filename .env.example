# Command AI: copie para .env (nunca versione o .env).

# API
PORT=3011
HOST=127.0.0.1
# Obrigatório em produção (mínimo de 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JOB_SIGNING_KEY=dev-only-signing-key-change-me-000000000000

# Runner (máquina do usuário)
COMMAND_AI_API_URL=http://127.0.0.1:3011
# Token mostrado uma única vez ao criar o Runner em Integrações
COMMAND_AI_RUNNER_TOKEN=
# Diretórios que o Runner pode tocar, separados por ; ou ,
RUNNER_ALLOWED_WORKSPACES=C:\Users\voce\projetos
# Sem esta chave o Runner usa o executor simulado
ANTHROPIC_API_KEY=

# --- Neon (gerado por `neon deploy` em .env.local; não copie valores reais para cá) ---
# DATABASE_URL=            # com pooler: tráfego da aplicação
# DATABASE_URL_UNPOOLED=   # direta: migrações
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# Schema do app no PostgreSQL (padrão command_ai)
# DB_SCHEMA=command_ai
# Use COMMAND_AI_STORAGE=memory para rodar sem banco
# COMMAND_AI_STORAGE=memory

# Desktop: servidor que o app abre (https fora de localhost)
# COMMAND_AI_URL=https://app.exemplo.com

# MFA obrigatório (padrão: true em produção, false fora dela)
# REQUIRE_MFA=true

# --- Papel restrito do banco (RLS) ---
# DATABASE_URL_APP é gerado em .env.db-app por `pnpm --filter @command-ai/api run db:create-app-role`.
# DATABASE_URL_APP=
# DB_APP_ROLE=command_ai_app
# Só em último caso (não recomendado): permite subir em produção sem o papel restrito
# ALLOW_DB_WITHOUT_RLS=true

# --- Redis, Worker e recuperação ---
# docker compose up -d redis   (127.0.0.1:6390)
# REDIS_URL=redis://127.0.0.1:6390
# API e Worker precisam dos MESMOS valores abaixo:
# LEASE_MS=60000
# BACKOFF_BASE_MS=5000
# BACKOFF_MAX_MS=300000
# MAX_EXECUTION_MS=7200000
# SWEEP_INTERVAL_MS=15000
# SWEEP_IN_PROCESS=true   # varredura dentro da API, sem Worker separado
